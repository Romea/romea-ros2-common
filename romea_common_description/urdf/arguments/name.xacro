<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find romea_common_description)/urdf/check.xacro"/>

  <xacro:property name="name" value="$(arg name)" />

  <xacro:property name="allowed_chars_in_name"
    value="${'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_'}" />

  <xacro:macro name="check_name">

    <xacro:assert_true
      condition="${name != ''}"
      message="name cannot be empty" />

    <xacro:assert_true
      condition="${name[0].isalpha()}"
      message="name must start with a letter. Got: ${name}" />

    <xacro:assert_true
      condition="${python.all(c in allowed_chars_in_name for c in name)}"
      message="name contains invalid characters. Allowed: [a-zA-Z0-9_]. Got: ${name}" />

    <xacro:assert_true
      condition="${'__' not in name}"
      message="name must not contain consecutive underscores. Got: ${name}" />

  </xacro:macro>

  <xacro:check_name/>

</robot>